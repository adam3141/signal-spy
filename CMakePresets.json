{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Target debug builds with debug symbols and optimizations disabled",
      "inherits": "common-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Target release builds with high optimizations",
      "inherits": "common-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "rel-profile",
      "displayName": "Release with Profiling",
      "description": "Release build with debug symbols enabled for profiling",
      "inherits": "common-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "common-build-base",
      "hidden": true
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "common-build-base"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": "common-build-base"
    },
    {
      "name": "rel-profile",
      "configurePreset": "rel-profile",
      "inherits": "common-build-base"
    }
  ]
}